__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Local data file - never committed
*.db
*.sqlite3
data/

# Personal status doc, not for the team
STATUS.md

# Personal build plans, same genre as STATUS.md. STATUS.md is the decision log;
# these are the working plans behind one feature each.
PLAN-*.md

# Filled-in sprints are data, the same as data/. templates/sprint.md is the
# committed part; sprints/NN.md is what you actually ran.
sprints/

# The published design canvases: 2.2MB each, and most of that is the canvas
# editor's own bundle rather than the design. The .dc.html artboards beside them
# are the source and are committed; these are the rendered pages, one Artifact
# fetch away.
.design/mastermind-ui-options.html
.design/charts/mastermind-chart-options.html
.design/sprint-sync/sprint-deliverable-sync.html
.design/sso/mastermind-sso-setup.html
.design/ws/mastermind-live-updates.html
.design/alerts/mastermind-late-and-stages.html
.design/map-theme/map-galaxy-or-brain.html
.design/project-kind/project-kind-on-the-map.html

# The AI provider key, and whatever sign-in values a deployment still keeps out
# here rather than on the Sign-in page.
.env
