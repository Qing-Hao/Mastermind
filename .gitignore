__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Local data file - never committed
*.db
*.sqlite3
data/

# Personal status doc, not for the team
STATUS.md

# Personal build plans, same genre as STATUS.md. STATUS.md is the decision log;
# these are the working plans behind one feature each.
PLAN-*.md

# Filled-in sprints are data, the same as data/. templates/sprint.md is the
# committed part; sprints/NN.md is what you actually ran.
sprints/

# The published design canvas: 2.2MB, and most of it is the canvas editor's own
# bundle rather than the design. The four .dc.html artboards beside it are the
# source and are committed; this is the rendered page, one Artifact fetch away.
.design/mastermind-ui-options.html

# Provider keys live in the environment. Never in the database - /api/export
# writes the whole file to JSON and would carry a key straight back out.
.env
