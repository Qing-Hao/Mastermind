# Copy to `.env` beside compose.yaml. `.env` is gitignored; this file is not.
#
# Sign-in is configured on its own page -- http://127.0.0.1:8000/auth/settings --
# and that includes the client secret and the session key. Everything in the
# first section below is a *fallback*: it is read only where the matching field
# on that page is empty, which is what keeps a deployment configured before those
# fields existed working unchanged.
#
# Note that `docker compose` reads this file and a bare `uvicorn` does not. That
# is the reason to prefer the page: what you type there is in the database and is
# there for every way of starting the app.
#
# The secrets are stored in `data/roadmap.db`. `/api/export` strips every
# sign-in field, so the JSON is safe to send; the database file and its backups
# are not. Clear the secret on the page before sharing one.

# --- fallbacks for the Sign-in page ------------------------------------------

# The Keycloak client secret. Confidential client: this is what makes the
# back-channel code exchange possible, and it is what lets the app skip
# verifying the ID token's signature locally (OIDC Core 3.1.3.7(6)).
MASTERMIND_OIDC_SECRET=

# Signs the session cookie. Any long random string -- e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave it unset in both places and the app generates one per process, which
# works but signs everybody out on every restart.
MASTERMIND_SESSION_KEY=

# Only if the browser reaches the app by a name other than the one the container
# sees -- behind a proxy, or on a host name. Keycloak compares this string
# exactly, and `localhost` and `127.0.0.1` are two different registrations.
# MASTERMIND_OIDC_REDIRECT_URI=https://mastermind.example.com/auth/callback

# Only for a development realm served over plain http. The no-signature-check
# argument rests entirely on TLS, so the app refuses an http token endpoint
# unless this says otherwise.
# MASTERMIND_OIDC_ALLOW_HTTP=1

# --- environment only, deliberately ------------------------------------------

# The recovery hatch. Set to `off` to skip the gate entirely for one run: the
# app behaves as it did before SSO and the Sign-in page is reachable again.
# For a rotated secret, a deleted client, a realm that is down, or a VPN that is
# not connected -- none of which any in-app design can solve, which is why this
# one has no field on the page.
MASTERMIND_SSO=

# Set by the container when it binds a non-loopback interface: it closes the
# Sign-in page's own exemption, so that page needs a signed-in session too. Not a
# field on the page, because a field could lock away the page that edits it.
# MASTERMIND_PUBLIC=1
