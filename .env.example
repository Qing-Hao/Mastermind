# Copy to `.env` beside compose.yaml. `.env` is gitignored; this file is not.
#
# Secrets live here and never in `data/roadmap.db`: `/api/export` writes the
# settings row to JSON, so a secret stored there would walk straight back out.
# Everything non-secret about sign-in -- issuer, client id, identity claim, who
# may in -- is configured at http://127.0.0.1:8000/auth/settings instead.

# The Keycloak client secret. Confidential client: this is what makes the
# back-channel code exchange possible, and it is what lets the app skip
# verifying the ID token's signature locally (OIDC Core 3.1.3.7(6)).
MASTERMIND_OIDC_SECRET=

# Signs the session cookie. Any long random string -- e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave it unset and the app generates one per process, which works but signs
# everybody out on every restart.
MASTERMIND_SESSION_KEY=

# The recovery hatch. Set to `off` to skip the gate entirely for one run: the
# app behaves as it did before SSO and the Sign-in page is reachable again.
# For a rotated secret, a deleted client, a realm that is down, or a VPN that is
# not connected -- none of which any in-app design can solve.
MASTERMIND_SSO=

# Only if the browser reaches the app by a name other than the one the container
# sees -- behind a proxy, or on a host name. Keycloak compares this string
# exactly, and `localhost` and `127.0.0.1` are two different registrations.
# MASTERMIND_OIDC_REDIRECT_URI=https://mastermind.example.com/auth/callback

# Only for a development realm served over plain http. The no-signature-check
# argument rests entirely on TLS, so the app refuses an http token endpoint
# unless this says otherwise.
# MASTERMIND_OIDC_ALLOW_HTTP=1
